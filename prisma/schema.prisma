generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Expression {
  id                String   @id @default(cuid())
  text              String   @unique
  translation       String
  meaning           String
  secondaryMeanings String?  // Store as JSON string
  type              String   // verb, phrasal_verb, idiom, etc.
  cefr              String   // A1-C2
  ipa               String?
  frequency         Float?
  formality         String?
  usageTips         String?  // Store as JSON string
  tenses            String?  // Store as JSON string
  imageUrl          String?
  mnemonic          String?
  status            String   @default("pending") // pending, learning, mastered
  difficulty        Int      @default(1)
  timesStudied      Int      @default(0)
  nextReviewAt      DateTime @default(now())
  interval          Int      @default(0)
  easiness          Float    @default(2.5)
  wordFamilies      String?  // Store as JSON string: { noun: string[], verb: string[], adjective: string[], adverb: string[] }
  phrasalVerbDetails String? // Store as JSON string
  chronology         String? // Store as JSON string: ChronologyData
  slangData          String?  // Store as JSON string: SlangData
  correction         String?  // Store as JSON string: { isCorrect: boolean, correctedText: string, explanation: string }
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  examples          Example[]
}

model Example {
  id                 String     @id @default(cuid())
  text               String
  translation        String?    // Added for hover translation
  literalTranslation String?    // Word by word
  subtitleAdaptation String?    // Localized subtitle
  tone               String?    // Sarcastic, urgent, etc.
  register           String?    // Street slang, highly formal
  category           String     // Medical Drama, Courtroom Thriller
  explanation        String?
  expressionId       String
  expression         Expression @relation(fields: [expressionId], references: [id])
}
model ActionMetric {
  id         String   @id @default(cuid())
  actionName String
  duration   Int      // In milliseconds
  success    Boolean
  error      String?
  metadata   String?  // JSON string for additional context
  createdAt  DateTime @default(now())
}

model JournalEntry {
  id              String   @id @default(cuid())
  userId          String   @default("default_user")
  title           String?
  content         String
  mode            String   @default("FREE_WRITING")
  mood            String?
  cefrLevel       String?
  metadata        String?  // JSON string
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  corrections     Correction[]
}

model Correction {
  id              String   @id @default(cuid())
  entryId         String
  type            String
  originalText    String
  suggestedText   String
  explanation     String
  rule            String?
  isFixed         Boolean  @default(false)
  entry           JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String   @id @default(cuid())
  slug        String   @unique // e.g. "cefr-a1-explorer"
  title       String
  description String
  type        String   // "CEFR" | "FAMILY" | "STREAK"
  unlockedAt  DateTime @default(now())
}

