{
  "ignorePaths": [
    "node_modules",
    ".next",
    "dist",
    "build",
    ".git",
    "scripts/tests",
    "reports"
  ],
  "rules": {
    "giantInterfaces": {
      "maxProperties": 25,
      "maxNesting": 5,
      "complexityThreshold": 500
    },
    "anyUsage": {
      "allowTypeAssertions": false
    },
    "circularDeps": {
      "enforcePureDomain": true
    }
  },
  "reporting": {
    "outputDir": "audit-results",
    "formats": [
      "json",
      "markdown",
      "html"
    ]
  }
}
